      "cmd": ":many",
      "text": "SELECT u.id AS user_id, u.name, count(o.id) AS order_count, coalesce(sum(o.amount), 0)::numeric AS total\nFROM users u\nLEFT JOIN orders o ON o.user_id = u.id\nWHERE u.created_at >= $1 AND u.status = $2\nGROUP BY u.id, u.name\nORDER BY total DESC",
